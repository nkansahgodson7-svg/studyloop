# Local SQLite is used when TURSO_DATABASE_URL is unset.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Encrypts per-user BYO LLM keys at rest. Required in production.
# Use a long random value: openssl rand -base64 32
ENCRYPTION_SECRET=

# Default LLM key for all users without a personal key.
GROQ_API_KEY=

# Shared code that enables self-service signup. Leave unset to close signup.
# Generate a long random value: openssl rand -base64 24
SIGNUP_INVITE_CODE=

# Optional. Only set to create the public demo account (demo@studyloop.app).
# Use a strong, unique value; leave unset in production unless you want the demo.
# DEMO_PASSWORD=

# Number of reverse proxies in front of the app. When set, the client IP for rate
# limiting is taken that many entries from the right of X-Forwarded-For, which a
# client cannot forge. Leave unset on Vercel (it overwrites the header).
# TRUST_PROXY_HOPS=1
